---
import CommandPalette from '../components/CommandPalette.astro';
import BrandIcon from '../components/BrandIcon.astro';
import '../styles/global.css';

const {
    title = 'John Paul Gonzaga — Full-Stack Developer (cmndrpaul)',
    description = 'Portfolio of John Paul Gonzaga (cmndrpaul), Full-Stack Developer specializing in Laravel, React, PHP, JavaScript, and modern web architectures.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="purple">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content={description}>
        <meta name="theme-color" content="#130a21">
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
    </head>
    <body x-data="portfolioApp()" class="relative flex min-h-screen flex-col overflow-x-hidden antialiased transition-colors duration-300">
        <div class="pointer-events-none fixed left-1/2 top-0 -z-10 h-[400px] w-[1000px] -translate-x-1/2 rounded-full bg-purple-600/10 blur-[130px]"></div>
        <div class="pointer-events-none fixed right-[-10%] top-[40%] -z-10 h-[500px] w-[500px] rounded-full bg-cyan-600/10 blur-[140px]"></div>

        <div class="pointer-events-none fixed left-0 top-0 z-50 h-[3px] w-full" aria-hidden="true">
            <div class="h-full rounded-r-full bg-[var(--accent)] shadow-[0_0_10px_var(--accent-glow)] transition-[width] duration-75" :style="'width: ' + scrollProgress + '%' "></div>
        </div>

        <header :class="scrolled ? 'bg-black/60 backdrop-blur-md border-b border-white/10 shadow-lg shadow-black/20' : 'bg-transparent border-b border-transparent'" class="fixed left-0 right-0 top-0 z-40 px-4 py-4 transition-all duration-300 sm:px-8">
            <div class="mx-auto flex max-w-6xl items-center justify-between">
                <a href="/" class="group flex items-center gap-2">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-500 text-lg font-bold text-white shadow-lg shadow-purple-500/30 transition-transform group-hover:scale-105">c</span>
                    <span class="text-lg font-bold tracking-tight text-white transition-colors group-hover:text-purple-400">cmndr<span class="text-purple-400">paul</span></span>
                </a>

                <nav class="hidden items-center gap-1 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 backdrop-blur-lg md:flex" aria-label="Main navigation">
                    <a href="/#about" class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-300 transition-colors hover:bg-white/10 hover:text-white">About</a>
                    <a href="/#experience" class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-300 transition-colors hover:bg-white/10 hover:text-white">Experience</a>
                    <a href="/#stack" class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-300 transition-colors hover:bg-white/10 hover:text-white">Stack</a>
                    <a href="/projects/" class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-300 transition-colors hover:bg-white/10 hover:text-white">Projects</a>
                    <a href="/certificates/" class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-300 transition-colors hover:bg-white/10 hover:text-white">Certificates</a>
                    <a href="/#contact" class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-300 transition-colors hover:bg-white/10 hover:text-white">Contact</a>
                </nav>

                <div class="flex items-center gap-2 sm:gap-3">
                    <button @click="toggleTheme()" type="button" title="Toggle Theme (Purple / Dark / Light)" aria-label="Toggle color theme" class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-purple-400 transition-all hover:border-purple-500/40 hover:bg-white/10">
                        <i data-lucide="sparkles" class="h-4 w-4"></i>
                    </button>
                    <a href="https://drive.google.com/file/d/17jZtoe9SSTAq-YNw4L4DoMPFIY50V2NA/view" target="_blank" rel="noopener noreferrer" class="hidden items-center gap-1.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 px-4 py-2 text-xs font-medium text-white shadow-lg shadow-purple-600/25 transition-all hover:-translate-y-0.5 hover:from-purple-500 hover:to-indigo-500 sm:inline-flex">
                        <i data-lucide="file-text" class="h-3.5 w-3.5"></i><span>CV</span>
                    </a>
                </div>
            </div>
        </header>

        <main class="flex-grow pt-24">
            <slot />
        </main>

        <footer class="mt-20 border-t border-white/10 bg-black/40 px-4 py-12 sm:px-8">
            <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 md:flex-row">
                <div class="flex flex-col items-center gap-3 text-center sm:flex-row sm:text-left">
                    <a href="/" class="flex items-center gap-2">
                        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr from-purple-600 to-indigo-500 text-sm font-bold text-white">c</span>
                        <span class="font-bold tracking-tight text-white">cmndrpaul</span>
                    </a>
                    <span class="hidden text-slate-600 sm:inline">•</span>
                    <p class="text-xs text-slate-400">© {new Date().getFullYear()} JOHN PAUL GONZAGA</p>
                </div>
                <div class="flex items-center gap-3">
                    <a href="https://github.com/cmndrpaul" target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition-colors hover:bg-white/10 hover:text-white" title="GitHub"><BrandIcon name="github" class="h-4 w-4" /></a>
                    <a href="https://www.linkedin.com/in/john-paul-gonzaga-562587284/" target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition-colors hover:bg-white/10 hover:text-white" title="LinkedIn"><BrandIcon name="linkedin" class="h-4 w-4" /></a>
                    <a href="https://www.facebook.com/cmndr.jp/" target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition-colors hover:bg-white/10 hover:text-white" title="Facebook"><BrandIcon name="facebook" class="h-4 w-4" /></a>
                    <a href="https://www.tiktok.com/@cmndr_jp" target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition-colors hover:bg-white/10 hover:text-white" title="TikTok"><BrandIcon name="tiktok" class="h-4 w-4" /></a>
                    <a href="mailto:cmndr.johnpaulgonzaga@gmail.com" class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition-colors hover:bg-white/10 hover:text-white" title="Email"><i data-lucide="mail" class="h-4 w-4"></i></a>
                </div>
            </div>
        </footer>

        <div class="fixed bottom-5 right-5 z-30 hidden sm:block">
            <button type="button" @click="commandPaletteOpen = true" aria-label="Open command menu" title="Search site (Ctrl+K)" class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-slate-900/90 text-slate-300 shadow-lg backdrop-blur transition-colors hover:border-purple-500/40 hover:text-white">
                <i data-lucide="command" class="h-4 w-4"></i>
            </button>
        </div>
        <CommandPalette />
        <script>
            import '../scripts/app.js';
        </script>
    </body>
</html>