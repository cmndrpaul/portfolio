---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Certificates & Honors — John Paul Gonzaga" description="Certificates and honors of John Paul Gonzaga.">
    <div class="mx-auto max-w-6xl space-y-12 px-4 py-8 sm:px-8">
        <div class="border-b border-white/10 pb-8">
            <a href="/" class="mb-3 inline-flex items-center gap-1 text-xs font-semibold text-purple-400 transition-colors hover:text-purple-300"><i data-lucide="arrow-left" class="h-3.5 w-3.5"></i><span>Back to Overview</span></a>
            <h1 class="text-3xl font-extrabold text-white sm:text-5xl">Certificates &amp; Honors</h1>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2"></div>
    </div>
</BaseLayout>