---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { education, experience, resumeUrl, technologies, technologyCategories } from '../data/portfolio.js';

const partnerLoop = Array.from({ length: 20 }, () => 'Trusted by Brands');
---

<BaseLayout>
    <div class="mx-auto max-w-6xl space-y-32 px-4 sm:px-8">
        <section class="relative flex min-h-[80vh] flex-col items-center justify-center overflow-hidden py-12 text-center">
            <div class="halftone pointer-events-none absolute inset-x-0 top-0 h-64 opacity-25" aria-hidden="true"></div>
            <div class="mb-4 inline-flex items-center gap-2">
                <span class="font-script rotate-[-4deg] text-2xl text-purple-400 sm:text-3xl">Hello world, I am</span>
                <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
                <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2 py-0.5 font-mono text-xs text-emerald-400">Available for Opportunities</span>
            </div>
            <h1 class="mb-6 text-4xl font-extrabold text-white sm:text-6xl md:text-7xl">John Paul <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-indigo-400 bg-clip-text text-transparent">Gonzaga</span></h1>
            <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-purple-500/30 bg-white/5 px-4 py-1.5 font-mono text-xs text-purple-300 backdrop-blur-md">
                <span>&lt;cmndrpaul /&gt;</span><span class="text-slate-500">•</span><span>Full-Stack Developer</span>
            </div>
            <p class="mb-10 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">Building modern full-stack web platforms, robust backend APIs, and responsive user experiences with precision and performance.</p>
            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="#projects" class="flex items-center gap-2 rounded-2xl bg-purple-600 px-6 py-3.5 text-sm font-semibold text-white shadow-xl shadow-purple-600/30 transition-all hover:-translate-y-0.5 hover:bg-purple-500 hover:shadow-purple-600/50"><span>Explore Projects</span><i data-lucide="arrow-down-right" class="h-4 w-4"></i></a>
                <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-6 py-3.5 text-sm font-semibold text-slate-200 backdrop-blur-md transition-all hover:border-purple-500/40 hover:bg-white/10"><i data-lucide="file-text" class="h-4 w-4 text-purple-400"></i><span>View Resume</span></a>
                <a href="https://github.com/cmndrpaul" target="_blank" rel="noopener noreferrer" title="GitHub" class="rounded-2xl border border-white/10 bg-white/5 p-3.5 text-slate-300 transition-colors hover:bg-white/10 hover:text-white"><BrandIcon name="github" class="h-5 w-5" /></a>
            </div>
            <div class="mt-16 grid w-full max-w-3xl grid-cols-1 gap-4 border-t border-white/10 pt-8 sm:grid-cols-3 sm:gap-6">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5 text-center backdrop-blur-sm"><div class="mb-1 text-2xl font-bold text-white sm:text-3xl">12+</div><div class="font-mono text-xs text-slate-400">Projects Delivered</div></div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5 text-center backdrop-blur-sm"><div class="mb-1 text-2xl font-bold text-purple-400 sm:text-3xl">3+</div><div class="font-mono text-xs text-slate-400">Years Experience</div></div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5 text-center backdrop-blur-sm"><div class="mb-1 text-2xl font-bold text-emerald-400 sm:text-3xl">100%</div><div class="font-mono text-xs text-slate-400">Commitment to Coding</div></div>
            </div>
        </section>

        <section class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden py-8">
            <div class="pointer-events-none absolute bottom-0 left-0 top-0 z-10 w-24 bg-gradient-to-r from-[var(--bg-main)] to-transparent"></div>
            <div class="pointer-events-none absolute bottom-0 right-0 top-0 z-10 w-24 bg-gradient-to-l from-[var(--bg-main)] to-transparent"></div>
            <div class="flex overflow-hidden"><div class="animate-marquee flex items-center gap-8 py-2">
                {partnerLoop.map((placeholder) => <div class="flex items-center justify-center whitespace-nowrap rounded-xl border border-white/10 bg-white/5 px-6 py-3"><span class="text-sm font-semibold text-white">{placeholder}</span></div>)}
            </div></div>
        </section>

        <section id="about" class="scroll-mt-24">
            <div class="mb-10 flex items-center gap-3"><span class="h-[2px] w-8 bg-purple-500"></span><span class="font-mono text-xs uppercase tracking-widest text-purple-400">01. About Me</span></div>
            <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
                <div class="flex justify-center lg:col-span-5"><div class="group relative">
                    <div class="absolute -inset-2 rounded-3xl bg-gradient-to-r from-purple-600 to-indigo-600 opacity-50 blur-xl transition duration-500 group-hover:opacity-80"></div>
                    <div class="relative flex h-64 w-64 flex-col items-center justify-center overflow-hidden rounded-3xl border border-white/20 bg-slate-900 p-6 text-center shadow-2xl sm:h-80 sm:w-80">
                        <img src="/portfolio-profile.jpg" alt="John Paul Gonzaga" class="mb-4 h-28 w-28 rounded-2xl border border-purple-300/30 object-cover object-top shadow-xl shadow-purple-600/40" loading="lazy">
                        <h3 class="text-lg font-bold text-white">John Paul Gonzaga</h3><p class="mt-1 font-mono text-xs text-purple-300">@cmndrpaul • Cavite, PH</p>
                        <div class="mt-4 flex items-center gap-2"><span class="h-2 w-2 animate-ping rounded-full bg-emerald-400"></span><span class="text-[11px] text-slate-300">Open for opportunities</span></div>
                    </div>
                </div></div>
                <div class="space-y-6 text-sm leading-relaxed text-slate-300 sm:text-base lg:col-span-7">
                    <h2 class="text-2xl font-bold text-white sm:text-3xl">Architecting high-impact software from pixel to server.</h2>
                    <p>I'm <strong class="font-semibold text-white">John Paul Gonzaga</strong>, known online as <span class="font-mono text-purple-400">cmndrpaul</span>. I am a Full-Stack Developer with a passion for building reliable, scalable, and intuitive web applications.</p>
                    <p>My core expertise spans modern web development including <span class="text-purple-300">Laravel</span>, <span class="text-purple-300">PHP</span>, <span class="text-purple-300">React</span>, <span class="text-purple-300">JavaScript</span>, <span class="text-cyan-300">Tailwind CSS</span>, <span class="text-cyan-300">Node.js</span>, <span class="text-pink-300">Express.js</span>, and relational databases like <span class="text-pink-300">MySQL</span>.</p>
                    <p>I focus on clean code, solid architectures, and seamless user experiences across every project I develop.</p>
                    <div class="grid grid-cols-2 gap-4 border-t border-white/10 pt-4 text-xs sm:text-sm">
                        <div class="flex items-center gap-2.5"><i data-lucide="check" class="h-4 w-4 text-purple-400"></i><span class="text-slate-200">Full-Stack Web Development</span></div>
                        <div class="flex items-center gap-2.5"><i data-lucide="check" class="h-4 w-4 text-purple-400"></i><span class="text-slate-200">REST APIs &amp; Backend Systems</span></div>
                        <div class="flex items-center gap-2.5"><i data-lucide="check" class="h-4 w-4 text-purple-400"></i><span class="text-slate-200">Database Design &amp; Optimization</span></div>
                        <div class="flex items-center gap-2.5"><i data-lucide="check" class="h-4 w-4 text-purple-400"></i><span class="text-slate-200">Responsive UI &amp; Modern Styling</span></div>
                    </div>
                </div>
            </div>
        </section>

        <section id="experience" class="scroll-mt-24">
            <div class="mb-10 flex items-center gap-3"><span class="h-[2px] w-8 bg-purple-500"></span><span class="font-mono text-xs uppercase tracking-widest text-purple-400">02. Career Timeline</span></div>
            <div class="space-y-12">
                <div><h2 class="mb-6 text-2xl font-bold text-white">Work Experience &amp; Roles</h2>
                    <div class="relative space-y-6 before:absolute before:bottom-3 before:left-3.5 before:top-3 before:w-[2px] before:bg-white/10">
                        {experience.map((item) => <div class="group relative pl-10">
                            <div class="absolute left-1.5 top-1.5 h-4 w-4 rounded-full border-2 border-purple-500 bg-slate-900 transition-all group-hover:scale-125 group-hover:bg-purple-500"></div>
                            <div class="space-y-3 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-md transition-all hover:border-purple-500/40">
                                <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-center"><div class="flex items-center gap-3"><img src={`/${item.icon}`} alt={`${item.company} logo`} class="h-10 w-10 rounded-xl border border-white/15 bg-white object-cover shadow-sm" loading="lazy"><h3 class="text-base font-bold text-white transition-colors group-hover:text-purple-400">{item.role}</h3></div><span class="w-fit rounded-full border border-purple-800/40 bg-purple-950/60 px-2.5 py-1 font-mono text-xs text-purple-300">{item.period}</span></div>
                                <div class="flex items-center gap-3 text-xs text-slate-400"><span class="font-medium text-slate-200">{item.company}</span><span>•</span><span>{item.location}</span></div>
                                <p class="text-xs leading-relaxed text-slate-300 sm:text-sm">{item.description}</p>
                                <div class="flex flex-wrap gap-1.5 pt-2">{item.badges.map((badge) => <span class="rounded border border-white/10 bg-white/5 px-2 py-0.5 font-mono text-[10px] text-slate-300">{badge}</span>)}</div>
                            </div>
                        </div>)}
                    </div>
                </div>
                <div class="border-t border-white/10 pt-8"><h2 class="mb-6 text-2xl font-bold text-white">Education &amp; Background</h2>
                    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">{education.map((item) => <div class="space-y-2 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-md transition-all hover:border-purple-500/40">
                        <div class="flex items-center justify-between"><span class="font-mono text-xs text-purple-300">{item.period}</span><i data-lucide="graduation-cap" class="h-4 w-4 text-purple-400"></i></div>
                        <div class="flex items-center gap-3"><img src={`/${item.icon}`} alt={`${item.institution} logo`} class="h-10 w-10 rounded-xl border border-white/15 bg-white object-cover shadow-sm" loading="lazy"><h3 class="text-base font-bold text-white">{item.degree}</h3></div>
                        <div class="text-xs font-medium text-slate-400">{item.institution}</div>
                    </div>)}</div>
                </div>
            </div>
        </section>

        <section id="stack" class="scroll-mt-24" x-data="{ activeCategory: 'All' }">
            <div class="mb-6 flex items-center gap-3"><span class="h-[2px] w-8 bg-purple-500"></span><span class="font-mono text-xs uppercase tracking-widest text-purple-400">03. Tech Arsenal</span></div>
            <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div><h2 class="text-2xl font-bold text-white sm:text-3xl">Skills &amp; Technologies</h2><p class="mt-1 text-xs text-slate-400 sm:text-sm">Tools and frameworks I use to build scalable products</p></div>
                <div class="flex flex-wrap gap-1.5">
                    <button @click="activeCategory = 'All'" :class="activeCategory === 'All' ? 'bg-purple-600 text-white shadow-lg shadow-purple-600/30' : 'bg-white/5 text-slate-300 hover:bg-white/10'" class="rounded-full border border-white/10 px-3 py-1.5 text-xs font-medium transition-all">All ({technologies.length})</button>
                    {technologyCategories.map((category) => <button @click={`activeCategory = '${category}'`} :class={`activeCategory === '${category}' ? 'bg-purple-600 text-white shadow-lg shadow-purple-600/30' : 'bg-white/5 text-slate-300 hover:bg-white/10'`} class="rounded-full border border-white/10 px-3 py-1.5 text-xs font-medium transition-all">{category}</button>)}
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-7">
                {technologies.map((tech) => <div x-show={`activeCategory === 'All' || activeCategory === '${tech.category}'`} x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100" class="group flex min-h-32 flex-col items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-3 py-4 text-center backdrop-blur-md transition-all hover:-translate-y-0.5 hover:border-purple-500/40 hover:bg-white/10 hover:shadow-xl hover:shadow-purple-950/40" title={tech.name}>
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5 transition-transform group-hover:scale-110">{tech.icon === 'java' ? <i data-lucide="coffee" class="h-8 w-8"></i> : <BrandIcon name={tech.icon} class="h-8 w-8" />}</div><div class="text-xs font-bold leading-tight text-white transition-colors group-hover:text-purple-300">{tech.name}</div>
                </div>)}
            </div>
        </section>

        <section id="projects" class="scroll-mt-24">
            <div class="mb-6 flex items-center gap-3"><span class="h-[2px] w-8 bg-purple-500"></span><span class="font-mono text-xs uppercase tracking-widest text-purple-400">04. Portfolio Work</span></div>
            <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-center"><div><h2 class="text-2xl font-bold text-white sm:text-3xl">Featured Projects</h2><p class="mt-1 text-xs text-slate-400 sm:text-sm">Highlighted web applications, platforms, and API systems</p></div><a href="/projects/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-purple-400 transition-colors hover:text-purple-300"><span>Browse all projects</span><i data-lucide="arrow-right" class="h-4 w-4"></i></a></div>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"></div>
            <div class="mt-12 text-center"><a href="/projects/" class="inline-flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-8 py-3.5 text-xs font-semibold text-white backdrop-blur-md transition-all hover:border-purple-500/40 hover:bg-white/10"><span>View Full Project Archive</span><i data-lucide="layers" class="h-4 w-4 text-purple-400"></i></a></div>
        </section>

        <section id="certificates" class="scroll-mt-24">
            <div class="mb-6 flex items-center gap-3"><span class="h-[2px] w-8 bg-purple-500"></span><span class="font-mono text-xs uppercase tracking-widest text-purple-400">05. Credentials</span></div>
            <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-center"><div><h2 class="text-2xl font-bold text-white sm:text-3xl">Certificates &amp; Honors</h2><p class="mt-1 text-xs text-slate-400 sm:text-sm">Accredited certifications and technical specializations</p></div><a href="/certificates/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-purple-400 transition-colors hover:text-purple-300"><span>View all credentials</span><i data-lucide="arrow-right" class="h-4 w-4"></i></a></div>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2"></div>
        </section>

        <section id="contact" class="scroll-mt-24 border-t border-white/10 pt-8" x-data="{ copied: false }">
            <div class="mb-6 flex items-center gap-3"><span class="h-[2px] w-8 bg-purple-500"></span><span class="font-mono text-xs uppercase tracking-widest text-purple-400">06. Get in Touch</span></div>
            <div class="space-y-8">
                <div><h2 class="text-3xl font-extrabold text-white sm:text-5xl">Let's collaborate on something extraordinary.</h2><p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">Have an exciting project, full-time role, or contract opportunity? My inbox is always open. Let's discuss how we can build something impactful together.</p></div>
                <div class="flex flex-col items-center justify-between gap-6 rounded-3xl border border-purple-500/30 bg-gradient-to-br from-purple-950/40 via-slate-900 to-indigo-950/40 p-6 shadow-2xl sm:flex-row sm:p-8">
                    <div><div class="mb-1 font-mono text-xs text-purple-300">Direct Email Address</div><div class="break-all font-mono text-lg font-bold text-white sm:text-2xl">cmndr.johnpaulgonzaga@gmail.com</div></div>
                    <div class="flex w-full items-center gap-3 sm:w-auto"><button @click="navigator.clipboard.writeText('cmndr.johnpaulgonzaga@gmail.com'); copied = true; setTimeout(() => copied = false, 2500)" class="flex flex-1 items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/10 px-5 py-3 text-xs font-semibold text-white transition-all hover:bg-white/15 sm:flex-initial"><i data-lucide="copy" class="h-4 w-4"></i><span x-text="copied ? 'Copied!' : 'Copy Email'"></span></button><a href="mailto:cmndr.johnpaulgonzaga@gmail.com" class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-purple-600 px-5 py-3 text-xs font-semibold text-white shadow-lg shadow-purple-600/30 transition-all hover:bg-purple-500 sm:flex-initial"><i data-lucide="mail" class="h-4 w-4"></i><span>Send Message</span></a></div>
                </div>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-4">
                    <a href="https://github.com/cmndrpaul" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 p-5 transition-all hover:border-purple-500/40"><div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-purple-400 transition-transform group-hover:scale-110"><BrandIcon name="github" class="h-5 w-5" /></span><span><span class="block text-xs font-bold text-white">GitHub</span><span class="font-mono text-[11px] text-slate-400">@cmndrpaul</span></span></div><i data-lucide="arrow-up-right" class="h-4 w-4 text-slate-500 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-purple-400"></i></a>
                    <a href="https://www.linkedin.com/in/john-paul-gonzaga-562587284/" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 p-5 transition-all hover:border-purple-500/40"><div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-purple-400 transition-transform group-hover:scale-110"><BrandIcon name="linkedin" class="h-5 w-5" /></span><span><span class="block text-xs font-bold text-white">LinkedIn</span><span class="font-mono text-[11px] text-slate-400">john-paul-gonzaga</span></span></div><i data-lucide="arrow-up-right" class="h-4 w-4 text-slate-500 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-purple-400"></i></a>
                    <a href="https://www.facebook.com/cmndr.jp/" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 p-5 transition-all hover:border-purple-500/40"><div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-purple-400 transition-transform group-hover:scale-110"><BrandIcon name="facebook" class="h-5 w-5" /></span><span><span class="block text-xs font-bold text-white">Facebook</span><span class="font-mono text-[11px] text-slate-400">cmndr.jp</span></span></div><i data-lucide="arrow-up-right" class="h-4 w-4 text-slate-500 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-purple-400"></i></a>
                    <a href="https://www.tiktok.com/@cmndr_jp" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 p-5 transition-all hover:border-purple-500/40"><div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-purple-400 transition-transform group-hover:scale-110"><BrandIcon name="tiktok" class="h-5 w-5" /></span><span><span class="block text-xs font-bold text-white">TikTok</span><span class="font-mono text-[11px] text-slate-400">@cmndr_jp</span></span></div><i data-lucide="arrow-up-right" class="h-4 w-4 text-slate-500 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-purple-400"></i></a>
                </div>
            </div>
        </section>
    </div>
</BaseLayout>