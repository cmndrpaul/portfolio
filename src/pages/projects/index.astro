---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects — John Paul Gonzaga" description="Project portfolio of John Paul Gonzaga.">
    <div class="mx-auto max-w-6xl space-y-12 px-4 py-8 sm:px-8">
        <div class="flex flex-col justify-between gap-6 border-b border-white/10 pb-8 md:flex-row md:items-end">
            <div>
                <a href="/" class="mb-3 inline-flex items-center gap-1 text-xs font-semibold text-purple-400 transition-colors hover:text-purple-300"><i data-lucide="arrow-left" class="h-3.5 w-3.5"></i><span>Back to Overview</span></a>
                <h1 class="text-3xl font-extrabold text-white sm:text-5xl">Project Archive</h1>
                <p class="mt-2 text-sm text-slate-400">Selected software engineering work</p>
            </div>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"></div>
    </div>
</BaseLayout>