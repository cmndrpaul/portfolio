---
import {
    siExpress,
    siFacebook,
    siFigma,
    siFirebase,
    siGithub,
    siHtml5,
    siJavascript,
    siLaravel,
    siMysql,
    siNodedotjs,
    siPhp,
    siReact,
    siSupabase,
    siTailwindcss,
    siTiktok,
    siVercel,
} from 'simple-icons';

const brandIcons = {
    express: siExpress,
    facebook: siFacebook,
    figma: siFigma,
    firebase: siFirebase,
    github: siGithub,
    html5: siHtml5,
    javascript: siJavascript,
    laravel: siLaravel,
    linkedin: null,
    mysql: siMysql,
    nodedotjs: siNodedotjs,
    php: siPhp,
    react: siReact,
    supabase: siSupabase,
    tailwindcss: siTailwindcss,
    tiktok: siTiktok,
    vercel: siVercel,
};

const { name, class: className = 'h-8 w-8' } = Astro.props;
const icon = brandIcons[name];
const iconColor = icon && Number.parseInt(icon.hex, 16) < 0x333333 ? '#ffffff' : icon ? `#${icon.hex}` : undefined;
---

{name === 'linkedin' ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
    </svg>
) : icon ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" style={`color: ${iconColor}`} aria-hidden="true">
        <path d={icon.path} />
    </svg>
) : null}